        "function rotate(store, token) {",
        "  const cur = store.get(token);",
        "  if (!cur || cur.used) throw new Error(\"reused\");",
        "  const next = crypto.randomBytes(16).toString(\"hex\");",
        "  store.set(next, { used: false });",
        "  return next;"
      ]
